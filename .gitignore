# =============================================================================
# Build output
# =============================================================================

# ROS 2 / colcon
**/build/
**/install/
**/log/

# ROS 1 / Catkin generated workspaces, including copied reference projects
**/devel/
**/build_isolated/
**/devel_isolated/
**/install_isolated/
**/.catkin_tools/
**/.catkin_workspace

# tf2_tools generated graph exports
/frames_*.gv
/frames_*.pdf

# CMake / Ninja / Make
**/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json
**/build.ninja
**/.ninja_deps
**/.ninja_log

# Keil MDK output directories
**/Objects/
**/Listings/
**/RTE/
**/DebugConfig/
**/intermediateFiles/

# This Keil target writes output to a directory named after the target.
/Telemetry framework/MDK-ARM/Telemetry framework/

# Compiler, linker, and firmware outputs
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.d
*.dep
*.crf
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.lnp
*.m51
*.plg
*.tra
*.build_log.htm

# Keil generated user/session/debug files
*.uvguix.*
*.scvd
*.dbgconf
JLinkLog.txt

# General executables and debug output
*.exe
*.out
*.ilk
*.pdb

# =============================================================================
# Language caches
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/

