<?xml version="1.0" encoding="UTF-8"?>
<!-- PC 端 CycloneDDS 配置：跨机单播 peer 指向 Jetson -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface name="wlp4s0"/>
      </Interfaces>
    </General>
    <Discovery>
      <Peers>
        <Peer address="192.168.166.76"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
