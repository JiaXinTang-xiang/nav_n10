[Unit]
Description=RobotProject native Nav2 and STM32 motion boundary
Requires=robot-stm32-bridge.service robot-localization.service
After=robot-stm32-bridge.service robot-localization.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data/ros2_ws /data/projects /data/logs

[Service]
Type=simple
User=HwHiAiUser
ExecStart=/data/ros2_ws/install/robot_navigation/lib/robot_navigation/start_production_navigation.sh
# Startup is automatic; faults and STOP are never cleared by a restart loop.
Restart=no
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
